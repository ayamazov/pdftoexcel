  ],
  "use_cases": [
    "Extract Italian bank statements (1980s–2000s) from scanned PDFs",
    "Build ricostruzione workbooks for anatocismo/usura dispute analysis",
    "Verify transcription against printed balances (5-axis reconciliation)",
    "Generate Excel input for accountant analysis",
    "Audit trail with checksums and timestamps"
  ],
  "requirements": {
    "tools": [
      "Read (image reading for OCR)",
      "Write (rows.json output)",
      "Bash (PDF rasterization: pdftoppm, pdfinfo)"
    ],
    "dependencies": {
      "python": "3.9+",
      "packages": [
        "pdfplumber",
        "pillow",
        "pandas",
        "openpyxl"
      ],
      "external": [
        "pdftoppm (poppler)",
        "pdfinfo (poppler)",
        "pdffonts (poppler)"
      ]
    },
    "files": {
      "/home/claude/estratto_toolkit.py": "Core processor (reconcile, validate, build-prep)",
      "/home/claude/test_estratto_toolkit.py": "Test suite (9 tests, all passing)",
      "scripts/classify_sheet.py": "Page classification (contact sheets)",
      "scripts/compact.py": "Image cropping & 8× zoom",
      "scripts/build_workbook.py": "Excel generation",
      "references/form-variants.md": "Column positions per form variant",
      "references/traps.md": "Common transcription errors",
      "references/output-format.md": "Workbook schema & descrizione vocabulary"
    }
  },
  "workflow": {
    "steps": 7,
    "step_1": "Inventory — Check PDF dimensions, page count, scanned vs OCR",
    "step_2": "Rasterize — 110 DPI (classification), 300 DPI (movements)",
    "step_3": "Classify — Read 2 contact sheets, identify ESTRATTO pages",
    "step_4": "Transcribe — Read compacted images + 8× zooms → rows.json",
    "step_5": "Reconcile — Verify 5 axes, report deltas",
    "step_6": "Validate — Schema check, type safety, date formats",
    "step_7": "Build — Generate Excel workbook (originale + data_valuta)"
  },
  "accuracy": {
    "guarantee": "100%",
    "method": "5-axis arithmetic reconciliation",
    "currency_support": ["ITL", "EUR"],
    "verification": "Closes to exact Lira or names the delta"
  },
  "budget": {
    "image_reads_per_20_pages": "10–15",
    "total_tokens_per_200_row_statement": "~2,300",
    "breakdown": {
      "image_reads": "~15 × 1,600 tokens = 24,000 tokens",
      "parsing": "~500 tokens",
      "total": "~2,500 tokens (with overhead)"
    }
  },
  "data_contract": {
    "input": "Scanned PDF (1980s–2000s Italian bank statements)",
    "intermediate": "rows.json (transaction-level data, single write)",
    "output": "Excel workbook (.xlsx) with verified transactions",
    "format": {
      "account": "string",
      "currency": "ITL | EUR",
      "statements": [
        {
          "estratto_al": "YYYY-MM-DD",
          "saldo_iniziale": "integer (Lire)",
          "saldo_finale": "integer (Lire)",
          "rows": [
            {
              "op": "YYYY-MM-DD",
              "val": "YYYY-MM-DD",
              "desc": "controlled vocabulary",
              "dare": "integer or null",
              "avere": "integer or null",
              "page": "PDF page number"
            }
          ]
        }
      ]
    }
  },
  "three_laws": [
    "Nothing ships until the arithmetic closes (to the exact Lira)",
    "Transcribe once into rows.json (don't retype or re-narrate)",
    "Spend CPU not reads (one dense image > many simple images)"
  ],
